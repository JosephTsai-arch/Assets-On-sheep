# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret used to sign server authentication tokens and sessions.
SESSION_SECRET="your-super-admin-session-secret"

# Super Admin Configuration (Database role 'super_admin' takes priority; env vars serve as secondary fallback)
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_LINE_USER_ID="Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# LINE Messaging API & LIFF configuration (can also be configured dynamically in Admin View Tab 5)
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_LIFF_ID=""
